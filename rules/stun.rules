# Sample STUN detection rules for Suricata test mode
alert udp any any -> any any (msg:"DPI STUN base gate"; app-layer-protocol:stun; sid:7700001; rev:1;)
alert udp any any -> any any (msg:"DPI Possible GoTo Connect Calling via STUN"; app-layer-protocol:stun; content:"|00 01|"; depth:2; content:"|21 12 a4 42|"; distance:2; within:4; sid:7700002; rev:1;)
